# URL gốc của backend Express (server.zip). KHÔNG có dấu / ở cuối.
# Dev local mặc định server chạy ở cổng 5000 (xem server/src/server.js).
VITE_API_URL=http://localhost:5000

# ID (MongoDB ObjectId, 24 ký tự hex) của sự kiện mà trang này hiển thị.
# Lấy từ Organizer sau khi tạo Event qua POST /api/events, hoặc từ
# server/src/utils/seed.js nếu bạn seed dữ liệu mẫu.
VITE_EVENT_ID=000000000000000000000000
