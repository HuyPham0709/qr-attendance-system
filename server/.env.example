PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/qr_attendance
REDIS_URL=redis://127.0.0.1:6379

# Cookie chỉ bật flag "secure" khi chạy qua HTTPS. Để false khi dev local (http://localhost).
COOKIE_SECURE=false

# BẮT BUỘC đổi thành 2 chuỗi ngẫu nhiên dài, khác nhau khi deploy thật.
# Tạo bằng: openssl rand -hex 64
# KHÔNG BAO GIỜ commit giá trị thật của .env (chỉ .env.example được commit).
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SLIDING_DAYS=7
REFRESH_TOKEN_ABSOLUTE_DAYS=30

# Origin (không có dấu / cuối) của 2 app React - dùng để whitelist CORS cho cookie.
CLIENT_ADMIN_ORIGIN=http://localhost:5173
CLIENT_SCANNER_ORIGIN=http://localhost:5174
