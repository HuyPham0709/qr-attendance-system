PORT=5000
MONGODB_URI=mongodb://<username>:<password>@<host>/<database>
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
QR_SIGNING_SECRET=your_qr_signing_secret_here
COOKIE_SECURE=false
NODE_ENV=development
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=30
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
CLIENT_ORIGIN=http://localhost:3000
CLIENT_ATTENDEE_ORIGIN=http://localhost:5175

# SMTP để gửi email QR cho Attendee. Để trống -> dev-mode (chỉ log ra console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="QR Attendance <no-reply@qr-attendance.local>"